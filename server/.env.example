# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public origin the browser uses (comma-separate several). Used for CSRF origin checks.
APP_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Database (MySQL 8 / MariaDB 10.6+) ────────────────────────────────────
# Hostinger: hPanel → Databases → MySQL Databases. Host is usually "localhost"
# for apps on the same hosting account. URL-encode special characters in the password.
DATABASE_URL=mysql://educore:educore@localhost:3306/educore

# ── Sessions ──────────────────────────────────────────────────────────────
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=72
# Set true when serving over HTTPS (always in production)
COOKIE_SECURE=false

# ── Object storage (S3-compatible, private bucket) — used from Phase 3 ─────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# When S3 is not configured, files are stored on local disk (development only)
LOCAL_STORAGE_DIR=./uploads

# ── Demo data ─────────────────────────────────────────────────────────────
# true = load the demo center on start, ONLY if the database has no users yet.
DEMO_SEED=false

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
